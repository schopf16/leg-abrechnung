          <TxDtls>
            <Refs>
              <AcctSvcrRef>ACCTSVCR-0002</AcctSvcrRef>
            </Refs>
            <RltdPties>
              <Dbtr><Nm>Muster Maxine</Nm></Dbtr>
            </RltdPties>
            <RmtInf>
              <Ustrd>Kundennummer 200500, vielen Dank</Ustrd>
            </RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>

      <!-- 3: outgoing payout, matched by counterparty IBAN -->
      <Ntry>
        <Amt Ccy="CHF">30.00</Amt>
        <CdtDbtInd>DBIT</CdtDbtInd>
        <BookgDt><Dt>2026-01-17</Dt></BookgDt>
