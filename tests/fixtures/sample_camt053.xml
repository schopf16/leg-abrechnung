      <!-- 1: incoming QR-bill payment with a valid, decodable QRR reference -->
      <Ntry>
        <Amt Ccy="CHF">123.45</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <BookgDt><Dt>2026-01-15</Dt></BookgDt>
