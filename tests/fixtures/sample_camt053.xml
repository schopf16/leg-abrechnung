            <RltdPties>
              <Dbtr><Nm>Muster Anna</Nm></Dbtr>
              <DbtrAcct><Id><IBAN>CH5604835012345678009</IBAN></Id></DbtrAcct>
            </RltdPties>
            <RmtInf>
              <Strd>
