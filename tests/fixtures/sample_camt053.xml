            <RmtInf>
              <Ustrd>Auszahlung Q4 2025</Ustrd>
            </RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>

      <!-- 4: foreign currency, must be skipped with a warning, never booked -->
      <Ntry>
        <Amt Ccy="EUR">40.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <BookgDt><Dt>2026-01-18</Dt></BookgDt>
