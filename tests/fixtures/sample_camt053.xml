                  <Ref>1002340000050000000000427</Ref>
                </CdtrRefInf>
              </Strd>
            </RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>

      <!-- 2: incoming payment with only free-text remittance info (no
           structured QRR reference), a candidate for fuzzy matching -->
