        </NtryDtls>
      </Ntry>

      <!-- 5: reversal of an earlier credit, must never be auto-matched,
           even though it carries a valid, decodable QRR reference -->
      <Ntry>
        <Amt Ccy="CHF">75.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <RvslInd>true</RvslInd>
        <BookgDt><Dt>2026-01-20</Dt></BookgDt>
        <ValDt><Dt>2026-01-20</Dt></ValDt>
